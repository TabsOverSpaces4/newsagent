# Copy to .env and fill in. Never commit .env.
# Claude API key for summarization (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Resend API key for email delivery (https://resend.com). If unset, the
# pipeline runs in --dry-run mode and writes out/preview.html instead.
RESEND_API_KEY=

# Comma-separated recipient emails. Kept out of git because the repo is public.
RECIPIENTS=you@example.com,friend@example.com

# From/reply-to addresses. FROM_EMAIL must be on a domain verified in Resend.
FROM_EMAIL=digest@yourdomain.com
REPLY_TO=you@example.com
