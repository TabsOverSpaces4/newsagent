<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chip Digest {{ run_date }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f4;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"
       style="max-width:600px; background-color:#ffffff; border-radius:6px;
              font-family:Georgia, 'Times New Roman', serif; color:#1a1a1a;">
<tr><td style="padding:28px 24px 8px 24px;">
  <p style="margin:0; font-size:13px; letter-spacing:1px; text-transform:uppercase; color:#888888;
            font-family:Helvetica, Arial, sans-serif;">Chip Digest &middot; {{ run_date }}</p>
  <p style="margin:14px 0 0 0; font-size:17px; line-height:1.55; color:#1a1a1a;">{{ digest.lede }}</p>
</td></tr>
{% for section in digest.sections %}
<tr><td style="padding:22px 24px 0 24px;">
  <h2 style="margin:0; padding-bottom:6px; font-size:14px; letter-spacing:1px; text-transform:uppercase;
             color:#0b5394; border-bottom:2px solid #0b5394;
             font-family:Helvetica, Arial, sans-serif;">{{ section.title }}</h2>
</td></tr>
{% for story in section.stories %}
<tr><td style="padding:16px 24px 4px 24px;">
  <h3 style="margin:0; font-size:17px; line-height:1.35;">
    <a href="{{ story.url }}" style="color:#1a1a1a; text-decoration:none;">{{ story.headline }}</a>
  </h3>
  <p style="margin:6px 0 0 0; font-size:15px; line-height:1.55; color:#333333;">{{ story.summary }}</p>
  <p style="margin:8px 0 0 0; font-size:14px; line-height:1.5; color:#555555; font-style:italic;">
    Why it matters: {{ story.why_it_matters }}</p>
  <p style="margin:8px 0 0 0; font-size:13px; font-family:Helvetica, Arial, sans-serif;">
    <a href="{{ story.url }}" style="color:#0b5394; text-decoration:underline;">Read at {{ story.source }}</a>
    {% for rel in story.related_urls %}
    &nbsp;&middot;&nbsp;<a href="{{ rel }}" style="color:#888888; text-decoration:underline;">related</a>
    {% endfor %}
  </p>
</td></tr>
{% endfor %}
{% endfor %}
<tr><td style="padding:28px 24px 24px 24px;">
  <p style="margin:0; border-top:1px solid #dddddd; padding-top:14px; font-size:12px; line-height:1.6;
            color:#999999; font-family:Helvetica, Arial, sans-serif;">
    You are receiving Chip Digest, a daily semiconductor news summary sent to a small private list.
    To unsubscribe, reply to this email with the word "unsubscribe" and you will be removed.
  </p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
