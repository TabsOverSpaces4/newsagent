<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>RFA Chip Digest {{ run_date }}</title>
<!--[if mso]>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<![endif]-->
<style type="text/css">
  body,table,td,a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
  table,td { mso-table-lspace:0pt; mso-table-rspace:0pt; }
  img { -ms-interpolation-mode:bicubic; border:0; outline:none; text-decoration:none; }
  a { color:#0B1F2A; }
  @media only screen and (max-width:620px) {
    .wrap { width:100% !important; }
    .pad { padding-left:20px !important; padding-right:20px !important; }
    .hd { font-size:19px !important; line-height:26px !important; }
    .lead { font-size:16px !important; line-height:25px !important; }
    .mast { font-size:22px !important; letter-spacing:2px !important; }
    .stack { display:block !important; width:100% !important; text-align:left !important; padding-top:8px !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#E9EDEF;">

<div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#E9EDEF;">
  {{ digest.lede | truncate(150, true, '...') }}
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#E9EDEF;">
  <tr>
    <td align="center" style="padding:28px 12px 40px 12px;">

      <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#FFFFFF;">

        <!-- ============ MASTHEAD ============ -->
        <tr>
          <td class="pad" style="background-color:#0B1F2A; padding:28px 32px 24px 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="left" style="font-family:Georgia,'Times New Roman',serif; font-size:26px; line-height:30px; font-weight:bold; letter-spacing:4px; color:#FFFFFF; text-transform:uppercase;" class="mast">
                  RFA&nbsp;Chip&nbsp;Digest
                </td>
                <td align="right" class="stack" style="font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:11px; line-height:16px; letter-spacing:1px; color:#C08A2E; white-space:nowrap;">
                  {{ run_date | replace('-', '\u2022') }}
                </td>
              </tr>
            </table>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding-top:14px; font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; line-height:14px; letter-spacing:2px; color:#7C93A1; text-transform:uppercase;">
                  Semiconductor brief
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="height:3px; line-height:3px; font-size:0; background-color:#C08A2E;">&nbsp;</td>
        </tr>

        <!-- ============ SECTION INDEX ============ -->
        <tr>
          <td class="pad" style="background-color:#F2F5F6; padding:13px 32px 13px 32px; border-bottom:1px solid #DCE3E7; font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; line-height:17px; letter-spacing:1.4px; color:#4A5A66; text-transform:uppercase;">
            {% for section in digest.sections %}
            {{ section.title }}{% if not loop.last %} &nbsp;&#183;&nbsp; {% endif %}
            {% endfor %}
          </td>
        </tr>

        <!-- ============ LEAD ============ -->
        <tr>
          <td class="pad" style="padding:30px 32px 26px 32px;">
            <div style="font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; line-height:14px; letter-spacing:2px; color:#C08A2E; text-transform:uppercase; padding-bottom:12px;">
              Today in brief
            </div>
            <div class="lead" style="font-family:Georgia,'Times New Roman',serif; font-size:17px; line-height:28px; color:#0B1F2A;">
              {{ digest.lede }}
            </div>
          </td>
        </tr>

        {% for section in digest.sections %}
        {% set is_research = 'research' in section.title | lower %}
        <!-- ============ SECTION: {{ section.title }} ============ -->
        <tr>
          <td class="pad" style="padding:{% if not loop.first %}14px{% else %}0{% endif %} 32px 0 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:11px; line-height:16px; letter-spacing:1.6px; color:#0B1F2A; text-transform:uppercase; font-weight:bold; white-space:nowrap; padding-right:12px;">
                  {{ section.title }}
                </td>
                <td width="100%" style="height:1px; line-height:1px; font-size:0; background-color:#DCE3E7;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        {% for story in section.stories %}
        <tr>
          <td class="pad" style="padding:24px 32px {% if loop.last and loop.revindex0 == 0 %}30px{% else %}26px{% endif %} 32px;">
            {% if is_research %}
            <div style="font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; line-height:14px; letter-spacing:1.6px; color:#C08A2E; text-transform:uppercase; padding-bottom:8px;">
              Research
            </div>
            {% endif %}
            <div class="hd" style="font-family:Georgia,'Times New Roman',serif; font-size:21px; line-height:29px; font-weight:bold; color:#0B1F2A; padding-bottom:10px;">
              {{ story.headline }}
            </div>
            <div style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; line-height:23px; color:#4A5A66; padding-bottom:16px;">
              {{ story.summary }}
            </div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F2F5F6; border-left:3px solid {% if is_research %}#C08A2E{% else %}#0B1F2A{% endif %};">
              <tr>
                <td style="padding:14px 18px 15px 16px;">
                  <div style="font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; line-height:14px; letter-spacing:1.4px; color:#0B1F2A; text-transform:uppercase; font-weight:bold; padding-bottom:6px;">
                    Why it matters
                  </div>
                  <div style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; line-height:21px; color:#4A5A66;">
                    {{ story.why_it_matters }}
                  </div>
                </td>
              </tr>
            </table>
            <div style="padding-top:15px; font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:11px; line-height:16px; letter-spacing:1px; text-transform:uppercase;">
              <a href="{{ story.url }}" style="color:#0B1F2A; text-decoration:none; border-bottom:1px solid #C08A2E; padding-bottom:2px;">{{ story.source }} &#8250;</a>
              {% for rel in story.related_urls %}
              &nbsp;&nbsp;<a href="{{ rel }}" style="color:#7C93A1; text-decoration:none; border-bottom:1px solid #DCE3E7; padding-bottom:2px; font-size:10px;">related &#8250;</a>
              {% endfor %}
            </div>
            {% if worker_url and story_feedback is defined and story.url in story_feedback %}
            {% set fb = story_feedback[story.url] %}
            <div style="padding-top:12px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                {% for s, label in [(0, 'Skip'), (4, 'Meh'), (7, 'Good'), (10, 'Great')] %}
                <td style="padding-right:6px;">
                  <a href="{{ worker_url }}/rate?sid={{ fb.sid }}&amp;s={{ s }}&amp;t={{ fb.hmacs[s] }}&amp;url={{ story.url | urlencode }}&amp;source={{ story.source | urlencode }}&amp;title={{ story.headline | urlencode }}&amp;rd={{ run_date }}"
                     style="display:inline-block; padding:4px 10px; font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; letter-spacing:1px; text-transform:uppercase; text-decoration:none; color:#4A5A66; border:1px solid #DCE3E7; border-radius:3px;">{{ label }}</a>
                </td>
                {% endfor %}
              </tr></table>
            </div>
            {% endif %}
          </td>
        </tr>
        {% if not loop.last %}
        <tr><td class="pad" style="padding:0 32px;"><div style="height:1px; line-height:1px; font-size:0; background-color:#ECEFF1;">&nbsp;</div></td></tr>
        {% endif %}
        {% endfor %}
        {% endfor %}

        <!-- ============ FOOTER ============ -->
        <tr>
          <td style="height:3px; line-height:3px; font-size:0; background-color:#C08A2E;">&nbsp;</td>
        </tr>
        <tr>
          <td class="pad" style="background-color:#0B1F2A; padding:26px 32px 28px 32px;">
            <div style="font-family:Georgia,'Times New Roman',serif; font-size:14px; line-height:18px; font-weight:bold; letter-spacing:3px; color:#FFFFFF; text-transform:uppercase; padding-bottom:12px;">
              RFA Chip Digest
            </div>
            <div style="font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; line-height:20px; color:#8FA3AF; padding-bottom:14px;">
              A semiconductor and AI hardware summary, sent to a small private list. Seven stories, no filler.
            </div>
            <div style="font-family:Consolas,'Liberation Mono',Menlo,monospace; font-size:10px; line-height:16px; letter-spacing:1px; color:#5E7684; text-transform:uppercase;">
              Reply with &ldquo;unsubscribe&rdquo; to be removed from the list.
            </div>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
